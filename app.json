{
  "expo": {
    "name": "Solitaire Game",
    "slug": "solitaire-game",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1b5e20"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1b5e20"
      },
      "package": "com.solitaire.game"
    },
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
